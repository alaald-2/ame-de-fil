# Local/dev placeholder only — never a real credential. See docs/SECURITY.md §7.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ame_de_fil?schema=public"
CORS_ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3002"
SESSION_COOKIE_NAME=ame_session
SESSION_TTL_HOURS=168
CSRF_COOKIE_NAME=ame_csrf
CART_COOKIE_NAME=ame_cart
CART_COOKIE_TTL_DAYS=30
CHECKOUT_RESERVATION_TTL_MINUTES=15
CHECKOUT_IDEMPOTENCY_TTL_HOURS=24
REFUND_IDEMPOTENCY_TTL_HOURS=1
ORDER_STATUS_TOKEN_TTL_HOURS=2
RESERVATION_EXPIRY_SWEEP_INTERVAL_MS=60000
TASK_AUTOMATION_SWEEP_INTERVAL_MS=300000
TASK_REFUND_PENDING_FOLLOWUP_HOURS=24
TASK_REFUND_FOLLOWUP_DELAY_DAYS=3
TASK_DELAYED_ORDER_GRACE_DAYS=2
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Optional — unset means PaymentsModule falls back to PendingPaymentProvider
# (no real processor, PENDING-only payments). Set both together to a Stripe
# test-mode secret key / webhook signing secret to exercise the real
# integration locally (never a live key — DECISIONS.md ADR-024, PAYMENTS.md §8).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — unset means NotificationsModule falls back to
# PendingEmailProvider (no send attempted, FAILED-recorded instead).
# Point at the docker-compose.yml Mailpit catcher for local dev
# (DECISIONS.md ADR-031); never a real vendor's credentials here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=

# Optional (all four together) — unset means IdentityModule falls back to
# PendingOAuthProvider (Google sign-in returns 503, no real Google API call
# is ever attempted). Set all four to a real Google Cloud OAuth client's
# credentials to exercise Google sign-in locally (never a live production
# client — DECISIONS.md ADR-033).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
STOREFRONT_BASE_URL="http://localhost:3001"

# Optional (all three together) — unset means CatalogModule's image upload
# falls back to PendingImageStorageProvider (uploads return a clear "not
# configured" error, never a silent failure). Set all three to a real
# Cloudinary account's credentials to exercise product image upload locally
# (DECISIONS.md ADR-034).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional (all three together) — unset means ShippingModule falls back to
# ManualShippingProvider (fixture rates/pickup points, no real carrier call).
# Set to a real Shipmondo sandbox user's HTTP Basic credentials to exercise
# the real integration locally (never production credentials here —
# DECISIONS.md ADR-037). SHIPMONDO_BASE_URL must point at the sandbox host
# during development: https://sandbox.shipmondo.com/api/public/v3
SHIPMONDO_API_USER=
SHIPMONDO_API_KEY=
SHIPMONDO_BASE_URL="https://sandbox.shipmondo.com/api/public/v3"
# The store's real ship-from address — required together with the three
# credentials above for ShipmondoShippingProvider to activate at all.
SHIPMONDO_SENDER_ADDRESS1=
SHIPMONDO_SENDER_ZIPCODE=
SHIPMONDO_SENDER_CITY=
SHIPMONDO_SENDER_COUNTRY_CODE="SE"

# Optional (all required-together vars below) — unset means ShippingModule
# falls back to ShipmondoShippingProvider (if configured) or
# ManualShippingProvider. When configured, PostNord takes precedence over
# both (DECISIONS.md ADR-040 — a direct integration, bypassing Shipmondo).
# POSTNORD_BASE_URL must point at the sandbox host during development:
# https://atapi2.postnord.com (production: https://api2.postnord.com)
POSTNORD_API_KEY=
POSTNORD_BASE_URL="https://atapi2.postnord.com"
# Assigned by PostNord during onboarding — not something to choose freely.
POSTNORD_CUSTOMER_KEY=
# The real PostNord customer/agreement number (a real carrier contract,
# separate from developer-portal signup).
POSTNORD_CUSTOMER_NUMBER=
# The store's real ship-from address — required together with the
# credentials above for PostNordShippingProvider to activate at all.
POSTNORD_SENDER_ADDRESS1=
POSTNORD_SENDER_ZIPCODE=
POSTNORD_SENDER_CITY=
POSTNORD_SENDER_COUNTRY_CODE="SE"
# Both genuinely undocumented in PostNord's own API spec (confirmed by
# direct schema inspection, not an oversight) — left unset until confirmed
# against a real sandbox call. Unset means pickup-point lookup returns no
# results (POSTNORD_SERVICE_POINTS_RETURN_TYPE) and a real booking's
# trackingNumber stays null (POSTNORD_TRACKING_ID_TYPE), never a guessed
# value (DECISIONS.md ADR-040).
POSTNORD_SERVICE_POINTS_RETURN_TYPE=
POSTNORD_TRACKING_ID_TYPE=
