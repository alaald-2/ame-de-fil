# Local/dev placeholder only — never a real credential. See docs/SECURITY.md §7.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
# Optional — publishable key only (never a secret, DECISIONS.md ADR-024).
# Unset means the Payment Element step never mounts; only meaningful when
# apps/api also has STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET configured.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
