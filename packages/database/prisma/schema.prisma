// Prisma schema — Âme de Fil
// Conceptual design: docs/DATABASE.md. Decisions: docs/DECISIONS.md ADR-009 (Prisma 7),
// ADR-021 (Sweden-only / sv-SE+en / SEK-only), ADR-022 (ShippingProvider abstraction).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Locale {
  sv_SE @map("sv-SE")
  en
}

// SEK-only for v1 (ADR-021). A single-value enum, not a plain string, so a
// future currency addition is a deliberate migration, not a silent typo.
enum Currency {
  SEK
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// InventoryMovement.type — every stock change is auditable through this log
// (DATABASE.md §4); never a raw UPDATE to onHand.
enum InventoryMovementType {
  SALE
  RETURN
  CANCELLATION
  RESTOCK
  ADJUSTMENT
}

enum StockReservationStatus {
  PENDING
  CONSUMED
  EXPIRED
}

// PAYMENTS.md §2. DISPUTED added beyond the brief for chargeback handling.
enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// PAYMENTS.md §3, plus PAYMENT_SUCCEEDED_STOCK_LOST from DATABASE.md §4's
// admin-alert state for the reservation-expired-before-webhook race.
enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PAYMENT_SUCCEEDED_STOCK_LOST
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELED
  REFUND_REQUESTED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ADR-022 — ManualShippingProvider drives this for v1; no carrier webhook exists yet.
enum ShipmentStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DataSubjectRequestType {
  EXPORT
  ERASURE
}

enum DataSubjectRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// Task.type — ROADMAP.md's admin Tasks feature. START_PRODUCTION through
// PACK_ORDER are the four pre-ship checklist items generated together for a
// made-to-order order and auto-closed together on READY_TO_SHIP (there is no
// per-step order status to distinguish them individually — see TasksModule's
// automation sweep). FOLLOW_UP_PENDING_REFUND/FOLLOW_UP_FAILED_REFUND/
// REVIEW_DISPUTE are read-only-detected from Refund/Payment state.
// INSPECT_RETURN is deliberately manual-only — no Return/RMA model exists in
// this schema to trigger it from.
enum TaskType {
  START_PRODUCTION
  FINISH_PRODUCTION
  QUALITY_CHECK
  PACK_ORDER
  SHIP_ORDER
  FOLLOW_UP_DELAYED_ORDER
  RESTOCK
  CUSTOMER_FOLLOW_UP
  FOLLOW_UP_PENDING_REFUND
  FOLLOW_UP_FAILED_REFUND
  REVIEW_DISPUTE
  INSPECT_RETURN
  GENERAL
}

enum TaskStatus {
  OPEN
  DONE
  CANCELED
}

// MANUAL: created by an admin. AUTOMATED: created by TaskAutomationService's
// periodic sweep (a read-only reader of Order/InventoryItem/Refund/Payment,
// never a writer of any of them — see admin-orders.service.ts/
// inventory.service.ts/payments/*, none of which this feature touches).
enum TaskSource {
  MANUAL
  AUTOMATED
}

// ─────────────────────────────────────────────────────────────────────────
// Identity, RBAC, sessions — SECURITY.md §1-2, DECISIONS.md ADR-015
// ─────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  // Nullable since ADR-033 (Google sign-in) — an OAuth-only account never
  // has one. Password-based login (AuthService) rejects a null hash the
  // same way it rejects a wrong one (SECURITY.md §1: never reveal which
  // failure reason applied), so this can't be used to distinguish an
  // OAuth-only account from a wrong password.
  passwordHash    String?
  firstName       String?
  lastName        String?
  phone           String?
  locale          Locale     @default(sv_SE)
  status          UserStatus @default(ACTIVE)
  // MFA-readiness only — unused until MFA ships (ADR-015).
  totpSecret      String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addresses                Address[]
  sessions                 Session[]
  oauthAccounts            OAuthAccount[]
  roles                    UserRole[]
  cart                     Cart?
  orders                   Order[]
  reviews                  Review[]
  wishlist                 Wishlist[]
  refundsInitiated         Refund[]                  @relation("RefundInitiatedBy")
  auditLogEntries          AuditLog[]
  consentRecords           ConsentRecord[]
  dataSubjectRequests      DataSubjectRequest[]
  inventoryMovements       InventoryMovement[]
  backInStockSubscriptions BackInStockSubscription[]
  notifications            Notification[]
  notesAboutMe             CustomerNote[]            @relation("CustomerNoteSubject")
  notesAuthored            CustomerNote[]            @relation("CustomerNoteAuthor")
  accountActionTokens      AccountActionToken[]
  loginOtps                LoginOtp[]
  assignedTasks            Task[]                    @relation("TaskAssignee")
  createdTasks             Task[]                    @relation("TaskCreatedBy")
  tasksAboutMe             Task[]                    @relation("TaskCustomer")

  @@index([status])
}

// Email-verification and password-reset bearer credentials — one table for
// both, distinguished only by `purpose` (mirrors Notification.type being a
// single free-form axis rather than two near-identical models). Hashed at
// rest (SHA-256, same posture/rationale as OrderStatusToken.tokenHash): a
// plaintext token is returned exactly once (in the verification/reset
// email), never persisted. Issuing a new token for a given (userId, purpose)
// invalidates any prior unconsumed one for that same purpose (AuthService),
// and consumption is a single conditional UPDATE
// (`consumedAt IS NULL AND expiresAt > now()`), making concurrent
// double-consumption of the same token race-safe by construction.
enum AccountActionTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AccountActionToken {
  id         String                    @id @default(cuid())
  userId     String
  purpose    AccountActionTokenPurpose
  tokenHash  String                    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Email one-time-code login credential — deliberately a SEPARATE model from
// AccountActionToken, not a third `purpose` value, for two concrete reasons:
// (1) AccountActionToken.tokenHash is globally @unique, which is only safe
// because a 256-bit token's collision odds are ~zero — a 6-digit code has
// only 1,000,000 possible values, so a global unique constraint would throw
// a real P2002 the first time two different users happen to hold the same
// code at once. `codeHash` here is therefore deliberately NOT unique;
// every lookup is scoped by `userId` too. (2) a low-entropy, human-typed
// code needs a per-code `attempts` counter as its primary defense (5 wrong
// tries kills it) — a 256-bit token is never brute-forced digit-by-digit, so
// AccountActionToken has no concept of this at all. Hashed at rest is still
// worth doing (defense-in-depth against a DB-leak during the code's live
// window), but unlike the 256-bit tokens, entropy is NOT the primary control
// here — short TTL + attempt-limiting + the resend cooldown are
// (AuthService.requestLoginOtp/loginWithOtp, DECISIONS.md ADR-036).
// Requesting a new code invalidates any prior unconsumed one for that user
// (same updateMany-then-create idiom AccountActionToken already uses), and
// consumption is the same race-safe conditional UPDATE.
model LoginOtp {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// Opaque token as primary key (ADR-015) — revocable, not a stateless JWT.
model Session {
  id        String    @id
  userId    String
  // Double-submit CSRF token (SECURITY.md §3), generated alongside the
  // session and compared against the client-echoed X-CSRF-Token header on
  // mutating requests — added during the Phase 1 API checkpoint when the
  // CSRF guard exposed that the original schema had nowhere to persist it.
  csrfToken String
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// One row per external identity linked to a User (ADR-033) — a dedicated
// table rather than a `googleId` column directly on `User`, mirroring how
// Session/OrderStatusToken are their own tables rather than columns on the
// row they belong to: `provider` is a plain string, not an enum (like
// Notification.type), so a second provider later needs no migration.
// `provider`+`providerAccountId` (Google's `sub` claim, never the email —
// a Google account's email can change) is the real identity key; a User
// can have more than one linked provider, and (in principle) the same
// provider account could be re-linked to a different User only by first
// unlinking, though no unlink path exists yet (not needed until more than
// one provider does).
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  name       String
  line1      String
  line2      String?
  postalCode String
  city       String
  country    String   @default("SE")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Catalog — DATABASE.md §1-2
// ─────────────────────────────────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  translations ProductTranslation[]
  images       ProductImage[]
  options      ProductOption[]
  variants     ProductVariant[]
  categories   ProductCategory[]
  collections  ProductCollection[]
  reviews      Review[]

  @@index([status])
}

// Product name/story/care-instructions/SEO metadata are content, not UI
// strings — next-intl only covers UI copy (DECISIONS.md ADR-007).
model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           Locale
  name             String
  slug             String
  description      String?
  story            String?
  careInstructions String?
  materials        String?
  metaTitle        String?
  metaDescription  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductImage {
  id                 String  @id @default(cuid())
  productId          String
  url                String
  position           Int     @default(0)
  altTextSv          String?
  altTextEn          String?
  // Nullable for migration safety on any pre-existing rows; every row
  // created through the admin upload endpoint always sets it — needed to
  // delete/transform the asset in Cloudinary later (deriving a public_id
  // back out of a URL is fragile, so it's stored explicitly).
  cloudinaryPublicId String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Option *type* (e.g. "color") is a small closed vocabulary — a UI string
// (next-intl), not DB content. Only option *values* are catalog content.
model ProductOption {
  id        String @id @default(cuid())
  productId String
  key       String
  position  Int    @default(0)

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  values       ProductOptionValue[]
  variantLinks ProductVariantOptionValue[]

  @@unique([productId, key])
}

model ProductOptionValue {
  id              String @id @default(cuid())
  productOptionId String
  value           String
  labelSv         String
  labelEn         String
  position        Int    @default(0)

  option       ProductOption               @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  variantLinks ProductVariantOptionValue[]

  @@unique([productOptionId, value])
}

// ProductVariant is the sellable unit — SKU/price/weight/stock (DATABASE.md §1).
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  // The main human/business identifier for this variant — permanent,
  // unique, sequential (100001, 100002, ...), and assigned by the database
  // itself the instant a variant is created (see the
  // "ProductVariant_articleNumber_seq" sequence added by this field's
  // migration), so generation can never race, skip, or be forgotten by an
  // application code path. Never reused, even once a variant is deleted —
  // Postgres sequences never hand out a value twice. Deliberately separate
  // from `sku` (a free-text, optional business/vendor code an admin may or
  // may not set) and from `id` (the real relational primary key everything
  // else — orders, carts, inventory, promotions — still references; this
  // column exists purely for humans, never as a join key).
  articleNumber Int      @unique @default(dbgenerated("nextval('\"ProductVariant_articleNumber_seq\"'::regclass)"))
  // Optional business/vendor code — no longer the primary identifier now
  // that articleNumber exists, but kept for admins who track their own SKU
  // scheme. Still unique when set; Postgres allows any number of NULLs
  // under a unique constraint, so leaving it blank never collides.
  sku           String?  @unique
  priceMinor    Int
  currency      Currency @default(SEK)
  taxClassId    String
  weightGrams   Int?
  lengthMm      Int?
  widthMm       Int?
  heightMm      Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product                  Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxClass                 TaxClass                    @relation(fields: [taxClassId], references: [id], onDelete: Restrict)
  optionValues             ProductVariantOptionValue[]
  inventoryItem            InventoryItem?
  cartItems                CartItem[]
  orderItems               OrderItem[]
  wishlistedBy             Wishlist[]
  backInStockSubscriptions BackInStockSubscription[]
  promotionVariants        PromotionVariant[]
  tasks                    Task[]

  @@index([productId])
}

// One value per option per variant, enforced by the unique constraint below
// (keyed on productVariantId + productOptionId, not the value itself).
model ProductVariantOptionValue {
  productVariantId     String
  productOptionId      String
  productOptionValueId String

  variant     ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  option      ProductOption      @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [productOptionValueId], references: [id], onDelete: Cascade)

  @@id([productVariantId, productOptionId])
}

model Category {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CategoryTranslation[]
  products     ProductCategory[]
}

model CategoryTranslation {
  id              String  @id @default(cuid())
  categoryId      String
  locale          Locale
  name            String
  slug            String
  description     String?
  metaTitle       String?
  metaDescription String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Collection {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations CollectionTranslation[]
  products     ProductCollection[]
}

model CollectionTranslation {
  id              String  @id @default(cuid())
  collectionId    String
  locale          Locale
  name            String
  slug            String
  description     String?
  metaTitle       String?
  metaDescription String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@unique([locale, slug])
}

model ProductCollection {
  productId    String
  collectionId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Tax — DATABASE.md §2 (Swedish moms only, no cross-border OSS — ADR-021)
// ─────────────────────────────────────────────────────────────────────────

model TaxClass {
  id   String @id @default(cuid())
  code String @unique
  name String

  rates    TaxRate[]
  variants ProductVariant[]
}

model TaxRate {
  id          String    @id @default(cuid())
  taxClassId  String
  ratePercent Decimal   @db.Decimal(5, 2)
  validFrom   DateTime  @default(now())
  validTo     DateTime?

  taxClass TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)

  @@index([taxClassId, validFrom, validTo])
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory & concurrency — DATABASE.md §4 (the highest-risk part of the schema)
// ─────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id                 String   @id @default(cuid())
  productVariantId   String   @unique
  onHand             Int      @default(0)
  reserved           Int      @default(0)
  tracksStock        Boolean  @default(true)
  productionTimeDays Int?
  isLimitedEdition   Boolean  @default(false)
  lowStockThreshold  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  variant      ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  movements    InventoryMovement[]
  reservations StockReservation[]
}

model InventoryMovement {
  id                 String                @id @default(cuid())
  inventoryItemId    String
  type               InventoryMovementType
  quantity           Int
  reason             String?
  relatedOrderItemId String?
  createdByUserId    String?
  createdAt          DateTime              @default(now())

  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  relatedOrderItem OrderItem?    @relation(fields: [relatedOrderItemId], references: [id], onDelete: SetNull)
  createdBy        User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  // Inventory-views checkpoint: GET /admin/inventory/movements orders the
  // cross-item ledger by createdAt DESC — unlike StockReservation (self-
  // bounding, already indexed on [status, expiresAt]), this table only
  // ever grows, and had no index supporting that sort at all (DATABASE.md §11).
  @@index([createdAt])
}

// Created at checkout-start (not add-to-cart), 15-minute TTL, released by a
// BullMQ job on expiry, consumed on a verified payment webhook (DATABASE.md §4).
// Linked to OrderItem, not CartItem: by checkout-start the Order already
// exists (PAYMENTS.md §3, DRAFT → PENDING_PAYMENT) and is the durable record —
// a clarification of the Phase 0 ERD, noted in DATABASE.md.
model StockReservation {
  id              String                 @id @default(cuid())
  orderItemId     String                 @unique
  inventoryItemId String
  quantity        Int
  status          StockReservationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime               @default(now())

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Cart & wishlist
// ─────────────────────────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  guestToken String?  @unique
  currency   Currency @default(SEK)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
}

model Wishlist {
  id               String   @id @default(cuid())
  userId           String
  productVariantId String
  createdAt        DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
}

// "Sold out" is a normal, frequent state for limited editions (PRODUCT_SPEC.md §3).
model BackInStockSubscription {
  id               String    @id @default(cuid())
  productVariantId String
  email            String
  userId           String?
  notifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productVariantId, email])
}

// ─────────────────────────────────────────────────────────────────────────
// Orders — PAYMENTS.md §3-4, DATABASE.md §4-5
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  guestEmail  String?
  locale      Locale
  status      OrderStatus @default(DRAFT)
  currency    Currency    @default(SEK)

  // Server-computed snapshots (DATABASE.md §5) — never trusted from the client.
  subtotalMinor Int
  discountMinor Int @default(0)
  shippingMinor Int @default(0)
  taxMinor      Int
  totalMinor    Int

  discountId       String?
  shippingMethodId String

  // Shipping method name, snapshotted the same way OrderItem already
  // snapshots product name/SKU (DATABASE.md §5) — closes the gap where
  // Order previously relied on a live join through shippingMethodId to
  // ShippingMethod.nameSv/nameEn, meaning a later name edit would silently
  // rewrite history (ADR-037). Nullable because pre-this-migration order
  // rows have nothing to backfill from.
  shippingMethodNameSnapshot String?

  // Chosen pickup point (ombud/paketbox), snapshotted at order time —
  // null when the selected shipping method doesn't require one
  // (ShippingMethod.requiresPickupPoint = false). id/name/address are a
  // provider-agnostic snapshot, never a live FK to a carrier's own
  // pickup-point directory (ADR-037).
  pickupPointId      String?
  pickupPointName    String?
  pickupPointAddress String?

  // Immutable address snapshots at order time — never a live FK to the
  // customer's editable address book (DATABASE.md §5 immutability principle
  // applied to addresses, not just money).
  shippingName       String
  shippingLine1      String
  shippingLine2      String?
  shippingPostalCode String
  shippingCity       String
  shippingCountry    String  @default("SE")
  shippingPhone      String?
  billingName        String
  billingLine1       String
  billingLine2       String?
  billingPostalCode  String
  billingCity        String
  billingCountry     String  @default("SE")
  billingPhone       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  canceledAt  DateTime?

  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  discount       Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod    @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]
  shipments      Shipment[]
  notes          CustomerNote[]
  statusToken    OrderStatusToken?
  tasks          Task[]

  @@index([status])
  @@index([userId])
  // Dashboard-metrics checkpoint: every revenue/order-count aggregation
  // filters on one of these two columns (createdAt for order-count
  // breakdowns, confirmedAt for revenue — DATABASE.md §10), both
  // previously unindexed, meaning a full table scan on every dashboard
  // request regardless of the requested date range's size.
  @@index([createdAt])
  @@index([confirmedAt])
}

// Guest-checkout authorization credential for the unauthenticated order-status
// polling endpoint (PAYMENTS.md §4's "poll the order status endpoint" rule —
// never the browser redirect). Issued once, in checkout's own transaction
// (DECISIONS.md ADR-024): a cryptographically random 256-bit token is
// returned to the client exactly once in the checkout response, and only its
// SHA-256 hash is ever persisted here — deliberately diverging from
// Session.id's plaintext-token convention, since this is a bearer credential
// with no session/cookie mechanism behind it. One token per order (orderId
// unique — not rotatable in v1), time-limited via expiresAt
// (ORDER_STATUS_TOKEN_TTL_HOURS) but reusable until expiry, since the
// storefront's polling loop calls the status endpoint repeatedly by design.
// An authenticated caller is authorized by Order.userId ownership instead —
// this table is the guest-only path.
model OrderStatusToken {
  id        String   @id @default(cuid())
  orderId   String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model OrderItem {
  id               String @id @default(cuid())
  orderId          String
  productVariantId String

  // Snapshots — a later price/name/tax-rate change must never alter history.
  productNameSnapshot   String
  variantLabelSnapshot  String
  // Nullable because the variant's own `sku` is optional (ProductVariant's
  // own schema comment) — an order placed for a variant with no SKU set has
  // nothing to snapshot here.
  skuSnapshot           String?
  // The variant's permanent articleNumber, snapshotted the same way as
  // skuSnapshot — unlike sku, articleNumber can never be null on the live
  // variant, but this column still is: pre-this-feature order rows have no
  // value to backfill from (the variant they reference may since have been
  // deleted), and there is deliberately no fabricated placeholder for that
  // history gap.
  articleNumberSnapshot Int?
  unitPriceMinor        Int
  quantity              Int
  taxRatePercent        Decimal @db.Decimal(5, 2)
  lineSubtotalMinor     Int
  lineTotalMinor        Int

  // Promotion snapshot (separate domain from Order.discountId/discountMinor,
  // which is reserved for the still-unbuilt Coupon system — see
  // promotions/effective-price.ts). unitPriceMinor above is already the
  // authoritative charged price whether or not a promotion applied;
  // basePriceMinor/promotionId/promotionPercentage exist purely so history
  // can later show "500 kr -> 400 kr (Autumn Sale, 20%)" without ever
  // depending on the variant's current price or the promotion's current
  // state. Nullable: pre-promotion-feature rows have none of this, and a
  // line with no active promotion at checkout time never had a discount to
  // record. promotionId is a real FK (SetNull, not Restrict) so a
  // (currently unbuilt) future promotion-delete path can never be blocked
  // by old orders — the snapshot fields already carry everything needed
  // once the row itself is gone.
  basePriceMinor      Int?
  promotionId         String?
  promotionPercentage Int?

  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  // Snapshot of InventoryItem.tracksStock/productionTimeDays at
  // checkout-start (DECISIONS.md ADR-030) — a later admin edit to a
  // variant's production time must never rewrite history for orders
  // already placed, same immutability principle as the price/tax/name
  // snapshots above. productionTimeDaysSnapshot can be null even when
  // madeToOrder is true (no estimate was ever set on the variant).
  madeToOrder                Boolean @default(false)
  productionTimeDaysSnapshot Int?

  createdAt DateTime @default(now())

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant            ProductVariant      @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  reservation        StockReservation?
  inventoryMovements InventoryMovement[]
  tasks              Task[]

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Payments — PAYMENTS.md (Stripe-unified for v1, ADR-014)
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id                      String        @id @default(cuid())
  orderId                 String
  provider                String        @default("stripe")
  providerPaymentIntentId String?       @unique
  method                  String?
  status                  PaymentStatus @default(PENDING)
  amountMinor             Int
  currency                Currency      @default(SEK)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]
  refunds  Refund[]

  @@index([orderId])
  @@index([status])
  // Dashboard-metrics checkpoint: payment-count-by-status is scoped by
  // createdAt.
  @@index([createdAt])
}

model PaymentAttempt {
  id              String        @id @default(cuid())
  paymentId       String
  status          PaymentStatus
  providerEventId String?
  rawPayload      Json?
  createdAt       DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Refund {
  id                String       @id @default(cuid())
  paymentId         String
  amountMinor       Int
  currency          Currency     @default(SEK)
  reason            String?
  status            RefundStatus @default(PENDING)
  providerRefundId  String?
  initiatedByUserId String?
  createdAt         DateTime     @default(now())
  processedAt       DateTime?

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  initiatedBy User?   @relation("RefundInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  // Dashboard-metrics checkpoint: refund-count-by-status is scoped by
  // createdAt (when initiated); the revenue-netting figure is scoped by
  // processedAt (when a SUCCEEDED refund's money actually moved) — the two
  // are deliberately different columns (DATABASE.md §10), so both are indexed.
  @@index([createdAt])
  @@index([processedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Shipping — ADR-022 (ShippingProvider abstraction, carrier deliberately
// not chosen; ManualShippingProvider for v1)
// ─────────────────────────────────────────────────────────────────────────

model ShippingMethod {
  id                  String   @id @default(cuid())
  code                String   @unique
  nameSv              String
  nameEn              String
  priceMinor          Int
  currency            Currency @default(SEK)
  minDeliveryDays     Int
  maxDeliveryDays     Int
  isActive            Boolean  @default(true)
  // Carrier-agnostic on purpose (ADR-022/ADR-037) — mirrors the generic
  // "service_point_product" concept every real carrier/aggregator exposes,
  // without naming a carrier. true means checkout must collect a chosen
  // pickup point (ombud/paketbox) before this method can be selected.
  requiresPickupPoint Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orders Order[]
}

// No carrier-specific fields or foreign keys (ADR-022) — carrierName and
// trackingNumber are free text, entered by admin via ManualShippingProvider.
model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  status         ShipmentStatus @default(PENDING)
  carrierName    String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// Discounts
// ─────────────────────────────────────────────────────────────────────────

model Discount {
  id               String       @id @default(cuid())
  name             String
  type             DiscountType
  // PERCENTAGE: 0-100. FIXED_AMOUNT: minor units in `currency` (enforced in
  // application logic, not a DB constraint — TESTING.md §2 covers this).
  value            Int
  currency         Currency?
  minSubtotalMinor Int?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  coupons Coupon[]
  orders  Order[]
}

model Coupon {
  id              String   @id @default(cuid())
  discountId      String
  code            String   @unique
  maxRedemptions  Int?
  redemptionCount Int      @default(0)
  createdAt       DateTime @default(now())

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@index([discountId])
}

// ─────────────────────────────────────────────────────────────────────────
// Promotions — deliberately independent of Discount/Coupon above. A
// Discount/Coupon reduces an Order's total via a customer-entered code
// (Order.discountId/discountMinor); a Promotion instead changes a specific
// ProductVariant's own effective *unit* price, no code required, and is
// consumed at the OrderItem line-item level (unitPriceMinor/basePriceMinor/
// promotionId above) — the two never share a table, a service, or a write
// path. See apps/api/src/promotions/effective-price.ts for where the
// effective price is actually computed (the base ProductVariant.priceMinor
// is never overwritten by an active promotion).
// ─────────────────────────────────────────────────────────────────────────

model Promotion {
  id         String    @id @default(cuid())
  name       String
  // Percentage off, 1-100 (enforced in application/DTO validation, not a DB
  // CHECK — same posture as Discount.value's own comment above). Version 1
  // is percentage-only by design (PRODUCT_SPEC checkpoint scope) — no
  // FIXED_AMOUNT/currency field, unlike Discount, since a % is inherently
  // currency-agnostic and this project is SEK-only today anyway.
  percentage Int
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  variants   PromotionVariant[]
  orderItems OrderItem[]

  @@index([active])
}

// Join table for "Promotion applies to these variants" (Promotion ->
// PromotionVariant -> ProductVariant). activeSnapshot/startsAtSnapshot/
// endsAtSnapshot duplicate the parent Promotion's own active/startsAt/endsAt
// at write time (kept in sync by PromotionsService inside the same
// transaction as any Promotion change) purely so the EXCLUDE constraint
// below can enforce "no two overlapping effective promotions per variant"
// at the database level — a Postgres EXCLUDE constraint can only reference
// columns on the table it's defined on, never a joined parent's columns,
// so there is no way to express this constraint against Promotion's own
// columns directly. PromotionsService (the only writer) is also the
// service-level backstop, run inside a pg_advisory_xact_lock keyed by
// variantId (see promotion-overlap.ts) so two concurrent admin requests
// can't both race past the pre-check — this constraint is the final,
// unbypassable layer under that, not the primary UX.
model PromotionVariant {
  id               String @id @default(cuid())
  promotionId      String
  productVariantId String

  activeSnapshot   Boolean
  startsAtSnapshot DateTime?
  endsAtSnapshot   DateTime?

  createdAt DateTime @default(now())

  promotion Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  // The migration's hand-written SQL adds:
  //   CREATE EXTENSION IF NOT EXISTS btree_gist;
  //   ALTER TABLE "PromotionVariant" ADD CONSTRAINT promotion_variant_no_overlap
  //     EXCLUDE USING gist (
  //       "productVariantId" WITH =,
  //       tsrange("startsAtSnapshot", COALESCE("endsAtSnapshot", 'infinity'), '[)') WITH &&
  //     ) WHERE ("activeSnapshot");
  // (tsrange, not tstzrange — every DateTime column here is TIMESTAMP(3)
  // without time zone.) Prisma's schema language has no way to declare
  // EXCLUDE/gist constraints, so this can't be expressed here; see the
  // migration.sql itself for the authoritative version.

  @@unique([promotionId, productVariantId])
  @@index([productVariantId])
}

// ─────────────────────────────────────────────────────────────────────────
// Reviews & customer notes
// ─────────────────────────────────────────────────────────────────────────

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

model CustomerNote {
  id           String   @id @default(cuid())
  userId       String
  authorUserId String
  orderId      String?
  body         String
  createdAt    DateTime @default(now())

  user   User   @relation("CustomerNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author User   @relation("CustomerNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications & audit — SECURITY.md §9
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  type      String
  channel   NotificationChannel @default(EMAIL)
  payload   Json
  status    NotificationStatus  @default(PENDING)
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

// Append-only — no update/delete path is exposed at the application layer
// (SECURITY.md §9), even though Prisma cannot enforce that at the schema level.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// GDPR — SECURITY.md §10
// ─────────────────────────────────────────────────────────────────────────

model ConsentRecord {
  id            String   @id @default(cuid())
  userId        String?
  anonymousId   String?
  consentType   String
  granted       Boolean
  policyVersion String
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([anonymousId])
}

model DataSubjectRequest {
  id          String                   @id @default(cuid())
  userId      String
  type        DataSubjectRequestType
  status      DataSubjectRequestStatus @default(PENDING)
  requestedAt DateTime                 @default(now())
  completedAt DateTime?
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Payment idempotency — PAYMENTS.md §5
// ─────────────────────────────────────────────────────────────────────────

// Primary key is the provider's own event ID — a duplicate webhook delivery
// (Stripe explicitly retries) is a no-op, not a double-processed payment.
model WebhookEvent {
  id          String    @id
  provider    String    @default("stripe")
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([provider, processedAt])
}

// Client-supplied idempotency keys on order/payment-creation endpoints —
// independent of Stripe's own webhook-delivery idempotency above.
model IdempotencyKey {
  key              String   @id
  scope            String
  requestHash      String?
  responseSnapshot Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Store settings — business info for the printable order receipt
// ─────────────────────────────────────────────────────────────────────────

// A fixed-id singleton, not a list — there is exactly one store. No natural
// unique key exists to build a "the one row" constraint around otherwise, so
// `id` is pinned to a known literal and every read/write targets it directly
// (upsert-on-first-read, never a 404).
model StoreSettings {
  id            String  @id @default("singleton")
  businessName  String?
  addressLine1  String?
  addressLine2  String?
  postalCode    String?
  city          String?
  country       String?
  orgNumber     String?
  vatNumber     String?
  phone         String?
  email         String?
  // Which of the fields above appear on a printed receipt — this is
  // letterhead metadata the admin can choose to omit; the receipt's actual
  // substance (order, items, totals) is never toggleable.
  showAddress   Boolean @default(true)
  showOrgNumber Boolean @default(true)
  showVatNumber Boolean @default(true)
  showPhone     Boolean @default(false)
  showEmail     Boolean @default(false)

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Homepage hero — admin-managed slider images, no product coupling
// ─────────────────────────────────────────────────────────────────────────

// One row per slide. Deliberately its own flat model, not something bolted
// onto Product/Collection — a hero slide is marketing content about the
// storefront itself (it may promote a collection, or nothing at all), not
// a property of any single catalog entity. `isActive` lets an admin queue
// up a slide (or pull one for a sale that's ended) without losing its
// position in the ordering — same reasoning as ProductVariant.isActive.
// CTA is optional per slide (bare imagery is a valid slide) and, like
// ProductImage's altTextSv/altTextEn, a flat bilingual pair rather than a
// separate translation table — there's no per-locale slug/SEO surface here
// that would justify one.
model HeroSlide {
  id                 String   @id @default(cuid())
  imageUrl           String
  // Nullable for the same migration-safety reason as ProductImage's own —
  // every row created through the admin upload endpoint always sets it.
  cloudinaryPublicId String?
  position           Int      @default(0)
  isActive           Boolean  @default(true)
  ctaLabelSv         String?
  ctaLabelEn         String?
  // A path or absolute URL, stored and rendered exactly as entered — no
  // locale-prefixing magic applied to it (an admin enters the already-
  // correct locale-specific path, e.g. "/en/shop" or "/produkter", the same
  // way any other freeform link elsewhere in this codebase is entered).
  ctaHref            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
}

// A small, fixed set of named content slots — the top hero heading, "Our
// craft", "Made to order" (all page.tsx on the storefront), and the
// site-wide announcement strip (announcement-bar.tsx, rendered in the
// header on every page, not just the homepage) — not a list an admin adds
// to or reorders like HeroSlide, exactly four rows that already exist by
// name in the storefront's own layout. Adding a fifth section means adding
// a fifth enum value and a fifth place in the relevant component, not a
// schema change to make this a list.
enum HomepageSectionKey {
  HERO
  STORY
  MADE_TO_ORDER
  ANNOUNCEMENT
}

// Rows are created lazily (upserted) on first edit, not pre-seeded —
// admin-homepage-sections.service.ts's list always returns all known keys
// regardless of whether a row exists yet, the same "upsert-on-first-read,
// never a 404" posture as StoreSettings' own comment. Every text field is
// nullable and, on the storefront, null falls back to the built-in
// next-intl copy (Home.storyTitle etc.) rather than rendering blank — so an
// admin who never touches this still gets the original launch copy, and an
// admin can revert a field to that default by clearing it back to empty.
// Flat bilingual columns, not a translation table, matching HeroSlide's own
// ctaLabelSv/En precedent — the same small-row-count, no-relational-need
// shape. HERO has no image/eyebrow/CTA of its own (the storefront renders
// it as a plain heading above the separate HeroSlide carousel — no
// description underneath; that field stays here only for the admin form's
// "revert to default" semantics if a subtitle is ever reintroduced), and
// ANNOUNCEMENT uses only titleSv/titleEn (its one line of text) — those
// rows just leave the columns they don't use null; one shared table for
// all four sections is simpler than a separate model per shape.
model HomepageSection {
  key                HomepageSectionKey @id
  imageUrl           String?
  cloudinaryPublicId String?
  eyebrowSv          String?
  eyebrowEn          String?
  titleSv            String?
  titleEn            String?
  descriptionSv      String?
  descriptionEn      String?
  ctaLabelSv         String?
  ctaLabelEn         String?
  ctaHref            String?
  updatedAt          DateTime           @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Admin Tasks — operational to-do items (production/fulfillment checklist,
// restock, refund/dispute follow-up, general work), manual or
// system-generated. See apps/api/src/tasks/task-automation.service.ts for
// the read-only sweep that generates AUTOMATED rows — it only reads
// Order/OrderItem/InventoryItem/Refund/Payment and only ever writes here,
// never the other way around.
// ─────────────────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  type        TaskType
  source      TaskSource @default(MANUAL)
  title       String
  notes       String?
  status      TaskStatus @default(OPEN)
  dueAt       DateTime?
  completedAt DateTime?

  assignedToUserId String?
  createdByUserId  String?

  // All four links are optional and independent — a task is usually *about*
  // something (an order, a specific line item, a variant running low, a
  // customer) but a GENERAL task stands alone with none of them set, same
  // "optional link, never required" posture as CustomerNote.orderId.
  orderId          String?
  orderItemId      String?
  productVariantId String?
  customerUserId   String?

  // Idempotency key for TaskAutomationService's upsert, e.g.
  // "order:{orderId}:READY_TO_SHIP_CHECKLIST" or
  // "refund:{refundId}:PENDING_FOLLOWUP" — makes the periodic sweep safe to
  // re-run indefinitely without ever creating a duplicate task. Null for
  // manually created tasks, which have no dedupe concept.
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User?           @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy  User?           @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customer   User?           @relation("TaskCustomer", fields: [customerUserId], references: [id], onDelete: SetNull)
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderItem  OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  variant    ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([assignedToUserId])
  @@index([orderId])
}
